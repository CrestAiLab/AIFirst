# Copy to .env.local and fill in (see README — you can paste values from Vercel → Project → Settings → Environment Variables).
# Same variables apply when you self-host; only the deployment UI changes.

# Required for Sanity content + Studio (/studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional locally: read-only homepage can use public dataset API in many setups.
# Required for scripts (seed, write) and draft/private content if you use tokens.
SANITY_API_TOKEN=

# Optional: Sanity webhook → /api/revalidate (set the same value in Sanity webhook config)
SANITY_REVALIDATE_SECRET=
